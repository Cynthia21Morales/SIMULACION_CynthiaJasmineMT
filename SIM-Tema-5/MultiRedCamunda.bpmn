<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Multired" targetNamespace="https://multired.example/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.0">
  <collaboration id="Collaboration_Multired" name="Proceso interbancario Multired">
    <participant id="Participant_ATM" name="ATM Multired" processRef="Process_ATM" />
    <participant id="Participant_Issuer" name="Banco emisor / Core bancario" processRef="Process_Issuer" />
    <participant id="Participant_Ops" name="Operaciones y conciliación" processRef="Process_Ops" />
    <messageFlow id="MF_Request" name="Solicitud interbancaria" sourceRef="A_SendRequest" targetRef="I_ReceiveRequest" messageRef="Msg_Request" />
    <messageFlow id="MF_Response" name="Respuesta de autorización" sourceRef="I_SendApproval" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_PINError" name="Respuesta NIP incorrecto" sourceRef="I_ReplyPINError" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_FundsError" name="Respuesta fondos insuficientes" sourceRef="I_ReplyNoFunds" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_LimitError" name="Respuesta límite excedido" sourceRef="I_ReplyLimit" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_AccountError" name="Respuesta cuenta no válida" sourceRef="I_ReplyAccountError" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_FormatError" name="Respuesta solicitud inválida" sourceRef="I_ReplyFormatError" targetRef="A_WaitResponse" messageRef="Msg_Response" />
    <messageFlow id="MF_SystemError" name="Respuesta error técnico" sourceRef="I_ReplySystemError" targetRef="A_WaitResponse" messageRef="Msg_Response" />
  </collaboration>
  <process id="Process_ATM" name="ATM Multired – Atención de transacción" isExecutable="false">
    <laneSet id="Process_ATM_LaneSet">
      <lane id="Lane_ATM" name="Terminal ATM">
        <flowNodeRef>A_Start</flowNodeRef>
        <flowNodeRef>A_ReadCard</flowNodeRef>
        <flowNodeRef>A_EncryptPIN</flowNodeRef>
        <flowNodeRef>A_CheckCard</flowNodeRef>
        <flowNodeRef>A_CardOK</flowNodeRef>
        <flowNodeRef>A_SelectOperation</flowNodeRef>
        <flowNodeRef>A_OperationType</flowNodeRef>
        <flowNodeRef>A_EnterAmount</flowNodeRef>
        <flowNodeRef>A_CheckAmount</flowNodeRef>
        <flowNodeRef>A_AmountOK</flowNodeRef>
        <flowNodeRef>A_ShowTimeout</flowNodeRef>
        <flowNodeRef>A_EndTimeout</flowNodeRef>
        <flowNodeRef>A_Approved</flowNodeRef>
        <flowNodeRef>A_ShowPINError</flowNodeRef>
        <flowNodeRef>A_PINAttempts</flowNodeRef>
        <flowNodeRef>A_BlockCard</flowNodeRef>
        <flowNodeRef>A_EndBlocked</flowNodeRef>
        <flowNodeRef>A_ShowNoFunds</flowNodeRef>
        <flowNodeRef>A_ShowLimit</flowNodeRef>
        <flowNodeRef>A_ShowIssuerError</flowNodeRef>
        <flowNodeRef>A_DispenseCash</flowNodeRef>
        <flowNodeRef>A_ConfirmDispense</flowNodeRef>
        <flowNodeRef>A_CalcCommission</flowNodeRef>
        <flowNodeRef>A_ShowBalance</flowNodeRef>
        <flowNodeRef>A_PrintReceipt</flowNodeRef>
        <flowNodeRef>A_LogTransaction</flowNodeRef>
        <flowNodeRef>A_ReturnCard</flowNodeRef>
        <flowNodeRef>A_EndSuccess</flowNodeRef>
        <flowNodeRef>A_EndBalance</flowNodeRef>
        <flowNodeRef>A_Cancel</flowNodeRef>
        <flowNodeRef>A_EndCancel</flowNodeRef>
        <flowNodeRef>A_WaitResponse</flowNodeRef>
        <flowNodeRef>A_Timeout</flowNodeRef>
        <flowNodeRef>A_ApprovedOp</flowNodeRef>
        <flowNodeRef>A_PrintBalanceReceipt</flowNodeRef>
        <flowNodeRef>A_LogBalance</flowNodeRef>
        <flowNodeRef>A_ReturnCardBalance</flowNodeRef>
        <flowNodeRef>A_LogDeclined</flowNodeRef>
        <flowNodeRef>A_ReturnCardDeclined</flowNodeRef>
        <flowNodeRef>A_EndDeclined</flowNodeRef>
        <flowNodeRef>A_EjectCard</flowNodeRef>
        <flowNodeRef>A_EndCardError</flowNodeRef>
        <flowNodeRef>A_AmountError</flowNodeRef>
        <flowNodeRef>A_BuildRequest</flowNodeRef>
        <flowNodeRef>A_SendRequest</flowNodeRef>
        <flowNodeRef>A_ResponseRace</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="A_Start" name="Cliente inserta tarjeta" />
    <task id="A_ReadCard" name="Leer tarjeta y validar chip" />
    <task id="A_EncryptPIN" name="Capturar PIN y cifrarlo" />
    <task id="A_CheckCard" name="Validar formato y estado de tarjeta" />
    <exclusiveGateway id="A_CardOK" name="¿Tarjeta válida?" />
    <task id="A_SelectOperation" name="Mostrar menú y seleccionar operación" />
    <exclusiveGateway id="A_OperationType" name="¿Tipo de operación?" />
    <task id="A_EnterAmount" name="Solicitar importe de retiro" />
    <task id="A_CheckAmount" name="Validar importe, múltiplos y límites locales" />
    <exclusiveGateway id="A_AmountOK" name="¿Importe válido?" />
    <task id="A_ShowTimeout" name="Informar timeout y registrar error de comunicación" />
    <endEvent id="A_EndTimeout" name="Operación abortada por timeout" />
    <exclusiveGateway id="A_Approved" name="¿Transacción aprobada?" />
    <task id="A_ShowPINError" name="Mostrar NIP incorrecto; permitir reintento" />
    <exclusiveGateway id="A_PINAttempts" name="¿Quedan intentos de PIN?" />
    <task id="A_BlockCard" name="Bloquear tarjeta por intentos excedidos" />
    <endEvent id="A_EndBlocked" name="Operación finalizada: tarjeta bloqueada" />
    <task id="A_ShowNoFunds" name="Informar fondos insuficientes" />
    <task id="A_ShowLimit" name="Informar límite diario excedido" />
    <task id="A_ShowIssuerError" name="Informar cuenta no válida o error del emisor" />
    <task id="A_DispenseCash" name="Dispensar efectivo" />
    <task id="A_ConfirmDispense" name="Confirmar dispensación al sistema" />
    <task id="A_CalcCommission" name="Calcular comisión interbancaria" />
    <task id="A_ShowBalance" name="Mostrar saldo disponible al cliente" />
    <task id="A_PrintReceipt" name="Ofrecer/imprimir comprobante" />
    <task id="A_LogTransaction" name="Registrar resultado y datos de auditoría" />
    <task id="A_ReturnCard" name="Devolver tarjeta" />
    <endEvent id="A_EndSuccess" name="Retiro exitoso" />
    <endEvent id="A_EndBalance" name="Consulta de saldo exitosa" />
    <task id="A_Cancel" name="Cancelar operación y devolver tarjeta" />
    <endEvent id="A_EndCancel" name="Operación cancelada por usuario" />
    <intermediateCatchEvent id="A_WaitResponse" name="Recibir respuesta del banco emisor">
      <messageEventDefinition messageRef="Msg_Response" />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="A_Timeout" name="Timeout de respuesta">
      <timerEventDefinition>
        <timeDuration>PT30S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <exclusiveGateway id="A_ApprovedOp" name="¿Operación aprobada y tipo?" />
    <task id="A_PrintBalanceReceipt" name="Ofrecer comprobante de consulta" />
    <task id="A_LogBalance" name="Registrar consulta de saldo" />
    <task id="A_ReturnCardBalance" name="Devolver tarjeta al cliente" />
    <task id="A_LogDeclined" name="Registrar rechazo de transacción" />
    <task id="A_ReturnCardDeclined" name="Devolver tarjeta tras rechazo" />
    <endEvent id="A_EndDeclined" name="Retiro rechazado" />
    <task id="A_EjectCard" name="Informar tarjeta inválida y devolver tarjeta" />
    <endEvent id="A_EndCardError" name="Operación cancelada: tarjeta inválida" />
    <task id="A_AmountError" name="Mostrar importe no válido y permitir corregir" />
    <task id="A_BuildRequest" name="Preparar solicitud interbancaria (retiro o consulta)" />
    <sendTask id="A_SendRequest" name="Enviar solicitud interbancaria al banco emisor" messageRef="Msg_Request" />
    <eventBasedGateway id="A_ResponseRace" name="¿Respuesta o timeout?" />
    <sequenceFlow id="A_F1" sourceRef="A_Start" targetRef="A_ReadCard" />
    <sequenceFlow id="A_F2" sourceRef="A_ReadCard" targetRef="A_EncryptPIN" />
    <sequenceFlow id="A_F25" name="Sí, reintentar" sourceRef="A_PINAttempts" targetRef="A_EncryptPIN" />
    <sequenceFlow id="A_F3" sourceRef="A_EncryptPIN" targetRef="A_CheckCard" />
    <sequenceFlow id="A_F4" sourceRef="A_CheckCard" targetRef="A_CardOK" />
    <sequenceFlow id="A_F5" name="Sí" sourceRef="A_CardOK" targetRef="A_SelectOperation" />
    <sequenceFlow id="A_F6" name="No" sourceRef="A_CardOK" targetRef="A_EjectCard" />
    <sequenceFlow id="A_F8" sourceRef="A_SelectOperation" targetRef="A_OperationType" />
    <sequenceFlow id="A_F9" name="Retiro" sourceRef="A_OperationType" targetRef="A_EnterAmount" />
    <sequenceFlow id="A_F39" name="Consulta de saldo" sourceRef="A_OperationType" targetRef="A_BuildRequest" />
    <sequenceFlow id="A_F41" name="Cancelar" sourceRef="A_OperationType" targetRef="A_Cancel" />
    <sequenceFlow id="A_F14" name="Corregir importe" sourceRef="A_AmountError" targetRef="A_EnterAmount" />
    <sequenceFlow id="A_F10" sourceRef="A_EnterAmount" targetRef="A_CheckAmount" />
    <sequenceFlow id="A_F11" sourceRef="A_CheckAmount" targetRef="A_AmountOK" />
    <sequenceFlow id="A_F12" name="Sí" sourceRef="A_AmountOK" targetRef="A_BuildRequest" />
    <sequenceFlow id="A_F13" name="No" sourceRef="A_AmountOK" targetRef="A_AmountError" />
    <sequenceFlow id="A_F20" sourceRef="A_Timeout" targetRef="A_ShowTimeout" />
    <sequenceFlow id="A_F21" sourceRef="A_ShowTimeout" targetRef="A_EndTimeout" />
    <sequenceFlow id="A_F19" sourceRef="A_WaitResponse" targetRef="A_Approved" />
    <sequenceFlow id="A_F22" name="Aprobada" sourceRef="A_Approved" targetRef="A_ApprovedOp" />
    <sequenceFlow id="A_F23" name="NIP incorrecto" sourceRef="A_Approved" targetRef="A_ShowPINError" />
    <sequenceFlow id="A_F28" name="Fondos insuficientes" sourceRef="A_Approved" targetRef="A_ShowNoFunds" />
    <sequenceFlow id="A_F29" name="Límite excedido" sourceRef="A_Approved" targetRef="A_ShowLimit" />
    <sequenceFlow id="A_F30" name="Cuenta no válida / error técnico" sourceRef="A_Approved" targetRef="A_ShowIssuerError" />
    <sequenceFlow id="A_F24" sourceRef="A_ShowPINError" targetRef="A_PINAttempts" />
    <sequenceFlow id="A_F26" name="No quedan intentos" sourceRef="A_PINAttempts" targetRef="A_BlockCard" />
    <sequenceFlow id="A_F27" sourceRef="A_BlockCard" targetRef="A_EndBlocked" />
    <sequenceFlow id="A_F31" sourceRef="A_ShowNoFunds" targetRef="A_LogDeclined" />
    <sequenceFlow id="A_F32" sourceRef="A_ShowLimit" targetRef="A_LogDeclined" />
    <sequenceFlow id="A_F33" sourceRef="A_ShowIssuerError" targetRef="A_LogDeclined" />
    <sequenceFlow id="A_F36" name="Retiro" sourceRef="A_ApprovedOp" targetRef="A_DispenseCash" />
    <sequenceFlow id="A_F37" sourceRef="A_DispenseCash" targetRef="A_ConfirmDispense" />
    <sequenceFlow id="A_F38" sourceRef="A_ConfirmDispense" targetRef="A_CalcCommission" />
    <sequenceFlow id="A_F43" sourceRef="A_CalcCommission" targetRef="A_PrintReceipt" />
    <sequenceFlow id="A_F47" name="Consulta de saldo" sourceRef="A_ApprovedOp" targetRef="A_ShowBalance" />
    <sequenceFlow id="A_F48" sourceRef="A_ShowBalance" targetRef="A_PrintBalanceReceipt" />
    <sequenceFlow id="A_F44" sourceRef="A_PrintReceipt" targetRef="A_LogTransaction" />
    <sequenceFlow id="A_F45" sourceRef="A_LogTransaction" targetRef="A_ReturnCard" />
    <sequenceFlow id="A_F46" sourceRef="A_ReturnCard" targetRef="A_EndSuccess" />
    <sequenceFlow id="A_F51" sourceRef="A_ReturnCardBalance" targetRef="A_EndBalance" />
    <sequenceFlow id="A_F42" sourceRef="A_Cancel" targetRef="A_EndCancel" />
    <sequenceFlow id="A_F17" name="Respuesta recibida" sourceRef="A_ResponseRace" targetRef="A_WaitResponse" />
    <sequenceFlow id="A_F18" name="30 segundos sin respuesta" sourceRef="A_ResponseRace" targetRef="A_Timeout" />
    <sequenceFlow id="A_F49" sourceRef="A_PrintBalanceReceipt" targetRef="A_LogBalance" />
    <sequenceFlow id="A_F50" sourceRef="A_LogBalance" targetRef="A_ReturnCardBalance" />
    <sequenceFlow id="A_F34" sourceRef="A_LogDeclined" targetRef="A_ReturnCardDeclined" />
    <sequenceFlow id="A_F35" sourceRef="A_ReturnCardDeclined" targetRef="A_EndDeclined" />
    <sequenceFlow id="A_F7" sourceRef="A_EjectCard" targetRef="A_EndCardError" />
    <sequenceFlow id="A_F15" sourceRef="A_BuildRequest" targetRef="A_SendRequest" />
    <sequenceFlow id="A_F16" sourceRef="A_SendRequest" targetRef="A_ResponseRace" />
  </process>
  <process id="Process_Issuer" name="Banco emisor – Core bancario" isExecutable="true">
    <laneSet id="Process_Issuer_LaneSet">
      <lane id="Lane_Issuer" name="Autorización bancaria">
        <flowNodeRef>I_Start</flowNodeRef>
        <flowNodeRef>I_ReceiveRequest</flowNodeRef>
        <flowNodeRef>I_ValidateMessage</flowNodeRef>
        <flowNodeRef>I_MessageOK</flowNodeRef>
        <flowNodeRef>I_ReplyFormatError</flowNodeRef>
        <flowNodeRef>I_EndFormatError</flowNodeRef>
        <flowNodeRef>I_ValidatePIN</flowNodeRef>
        <flowNodeRef>I_PINOK</flowNodeRef>
        <flowNodeRef>I_ReplyPINError</flowNodeRef>
        <flowNodeRef>I_EndPIN</flowNodeRef>
        <flowNodeRef>I_ValidateAccount</flowNodeRef>
        <flowNodeRef>I_AccountOK</flowNodeRef>
        <flowNodeRef>I_ReplyAccountError</flowNodeRef>
        <flowNodeRef>I_EndAccount</flowNodeRef>
        <flowNodeRef>I_CheckDailyLimit</flowNodeRef>
        <flowNodeRef>I_LimitOK</flowNodeRef>
        <flowNodeRef>I_ReplyLimit</flowNodeRef>
        <flowNodeRef>I_EndLimit</flowNodeRef>
        <flowNodeRef>I_CheckFunds</flowNodeRef>
        <flowNodeRef>I_FundsOK</flowNodeRef>
        <flowNodeRef>I_ReplyNoFunds</flowNodeRef>
        <flowNodeRef>I_EndFunds</flowNodeRef>
        <flowNodeRef>I_ReserveFunds</flowNodeRef>
        <flowNodeRef>I_CalcIssuerFee</flowNodeRef>
        <flowNodeRef>I_Audit</flowNodeRef>
        <flowNodeRef>I_SendApproval</flowNodeRef>
        <flowNodeRef>I_EndApproved</flowNodeRef>
        <flowNodeRef>I_ReleaseReservation</flowNodeRef>
        <flowNodeRef>I_ReplySystemError</flowNodeRef>
        <flowNodeRef>I_EndSystemError</flowNodeRef>
        <flowNodeRef>I_ReserveOK</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="I_Start" name="Solicitud de retiro recibida">
      <messageEventDefinition id="I_StartMsgDef" messageRef="Msg_Request" />
    </startEvent>
    <receiveTask id="I_ReceiveRequest" name="Recibir solicitud y correlacionar transacción" messageRef="Msg_Request" />
    <task id="I_ValidateMessage" name="Validar formato, identificador y datos obligatorios" />
    <exclusiveGateway id="I_MessageOK" name="¿Solicitud íntegra?" />
    <sendTask id="I_ReplyFormatError" name="Responder solicitud inválida" messageRef="Msg_Response" />
    <endEvent id="I_EndFormatError" name="Solicitud rechazada" />
    <task id="I_ValidatePIN" name="Verificar NIP cifrado" />
    <exclusiveGateway id="I_PINOK" name="¿NIP correcto?" />
    <sendTask id="I_ReplyPINError" name="Responder NIP incorrecto" messageRef="Msg_Response" />
    <endEvent id="I_EndPIN" name="NIP incorrecto" />
    <task id="I_ValidateAccount" name="Validar cuenta, tarjeta, estado y vigencia" />
    <exclusiveGateway id="I_AccountOK" name="¿Cuenta activa?" />
    <sendTask id="I_ReplyAccountError" name="Responder cuenta o tarjeta bloqueada" messageRef="Msg_Response" />
    <endEvent id="I_EndAccount" name="Cuenta no válida" />
    <task id="I_CheckDailyLimit" name="Consultar límites diarios y reglas antifraude" />
    <exclusiveGateway id="I_LimitOK" name="¿Dentro del límite?" />
    <sendTask id="I_ReplyLimit" name="Responder límite excedido" messageRef="Msg_Response" />
    <endEvent id="I_EndLimit" name="Límite excedido" />
    <task id="I_CheckFunds" name="Consultar saldo y fondos disponibles" />
    <exclusiveGateway id="I_FundsOK" name="¿Fondos suficientes?" />
    <sendTask id="I_ReplyNoFunds" name="Responder fondos insuficientes" messageRef="Msg_Response" />
    <endEvent id="I_EndFunds" name="Fondos insuficientes" />
    <task id="I_ReserveFunds" name="Reservar/debitar importe de forma transaccional" />
    <task id="I_CalcIssuerFee" name="Calcular comisión y registrar cargos" />
    <task id="I_Audit" name="Registrar auditoría y actualizar historial" />
    <sendTask id="I_SendApproval" name="Enviar aprobación y datos de saldo/comisión" messageRef="Msg_Response" />
    <endEvent id="I_EndApproved" name="Transacción autorizada" />
    <task id="I_ReleaseReservation" name="Liberar reserva si falla la operación" />
    <sendTask id="I_ReplySystemError" name="Responder error interno o indisponibilidad" messageRef="Msg_Response" />
    <endEvent id="I_EndSystemError" name="Error técnico informado" />
    <exclusiveGateway id="I_ReserveOK" name="¿Reserva de fondos confirmada?" />
    <sequenceFlow id="I_F1" sourceRef="I_Start" targetRef="I_ReceiveRequest" />
    <sequenceFlow id="I_F2" sourceRef="I_ReceiveRequest" targetRef="I_ValidateMessage" />
    <sequenceFlow id="I_F3" sourceRef="I_ValidateMessage" targetRef="I_MessageOK" />
    <sequenceFlow id="I_F4" name="Sí" sourceRef="I_MessageOK" targetRef="I_ValidatePIN" />
    <sequenceFlow id="I_F5" name="No" sourceRef="I_MessageOK" targetRef="I_ReplyFormatError" />
    <sequenceFlow id="I_F6" sourceRef="I_ReplyFormatError" targetRef="I_EndFormatError" />
    <sequenceFlow id="I_F7" sourceRef="I_ValidatePIN" targetRef="I_PINOK" />
    <sequenceFlow id="I_F8" name="Sí" sourceRef="I_PINOK" targetRef="I_ValidateAccount" />
    <sequenceFlow id="I_F9" name="No" sourceRef="I_PINOK" targetRef="I_ReplyPINError" />
    <sequenceFlow id="I_F10" sourceRef="I_ReplyPINError" targetRef="I_EndPIN" />
    <sequenceFlow id="I_F11" sourceRef="I_ValidateAccount" targetRef="I_AccountOK" />
    <sequenceFlow id="I_F12" name="Sí" sourceRef="I_AccountOK" targetRef="I_CheckDailyLimit" />
    <sequenceFlow id="I_F13" name="No" sourceRef="I_AccountOK" targetRef="I_ReplyAccountError" />
    <sequenceFlow id="I_F14" sourceRef="I_ReplyAccountError" targetRef="I_EndAccount" />
    <sequenceFlow id="I_F15" sourceRef="I_CheckDailyLimit" targetRef="I_LimitOK" />
    <sequenceFlow id="I_F16" name="Sí" sourceRef="I_LimitOK" targetRef="I_CheckFunds" />
    <sequenceFlow id="I_F17" name="No" sourceRef="I_LimitOK" targetRef="I_ReplyLimit" />
    <sequenceFlow id="I_F18" sourceRef="I_ReplyLimit" targetRef="I_EndLimit" />
    <sequenceFlow id="I_F19" sourceRef="I_CheckFunds" targetRef="I_FundsOK" />
    <sequenceFlow id="I_F20" name="Sí" sourceRef="I_FundsOK" targetRef="I_ReserveFunds" />
    <sequenceFlow id="I_F21" name="No" sourceRef="I_FundsOK" targetRef="I_ReplyNoFunds" />
    <sequenceFlow id="I_F22" sourceRef="I_ReplyNoFunds" targetRef="I_EndFunds" />
    <sequenceFlow id="I_F23" sourceRef="I_ReserveFunds" targetRef="I_ReserveOK" />
    <sequenceFlow id="I_F24" name="Sí" sourceRef="I_ReserveOK" targetRef="I_CalcIssuerFee" />
    <sequenceFlow id="I_F26" sourceRef="I_CalcIssuerFee" targetRef="I_Audit" />
    <sequenceFlow id="I_F27" sourceRef="I_Audit" targetRef="I_SendApproval" />
    <sequenceFlow id="I_F28" sourceRef="I_SendApproval" targetRef="I_EndApproved" />
    <sequenceFlow id="I_F25" name="No" sourceRef="I_ReserveOK" targetRef="I_ReleaseReservation" />
    <sequenceFlow id="I_F29" sourceRef="I_ReleaseReservation" targetRef="I_ReplySystemError" />
    <sequenceFlow id="I_F30" sourceRef="I_ReplySystemError" targetRef="I_EndSystemError" />
  </process>
  <process id="Process_Ops" name="Operaciones – Conciliación y seguimiento" isExecutable="false">
    <laneSet id="Process_Ops_LaneSet">
      <lane id="Lane_Ops" name="Operaciones y conciliación">
        <flowNodeRef>O_Start</flowNodeRef>
        <flowNodeRef>O_LoadTransactions</flowNodeRef>
        <flowNodeRef>O_Reconcile</flowNodeRef>
        <flowNodeRef>O_ReconcileOK</flowNodeRef>
        <flowNodeRef>O_CreateIncident</flowNodeRef>
        <flowNodeRef>O_Review</flowNodeRef>
        <flowNodeRef>O_Adjust</flowNodeRef>
        <flowNodeRef>O_GenerateReport</flowNodeRef>
        <flowNodeRef>O_End</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="O_Start" name="Evento de conciliación programada" />
    <task id="O_LoadTransactions" name="Cargar transacciones y comisiones del periodo" />
    <task id="O_Reconcile" name="Conciliar registros del ATM y del banco emisor" />
    <exclusiveGateway id="O_ReconcileOK" name="¿Importes conciliados?" />
    <task id="O_CreateIncident" name="Crear incidencia por diferencias y notificar operaciones" />
    <task id="O_Review" name="Revisar trazas, respuesta bancaria y comprobantes" />
    <task id="O_Adjust" name="Registrar ajuste autorizado y documentar resolución" />
    <task id="O_GenerateReport" name="Generar reporte de transacciones, tiempos y comisiones" />
    <endEvent id="O_End" name="Conciliación finalizada" />
    <sequenceFlow id="O_F1" sourceRef="O_Start" targetRef="O_LoadTransactions" />
    <sequenceFlow id="O_F2" sourceRef="O_LoadTransactions" targetRef="O_Reconcile" />
    <sequenceFlow id="O_F3" sourceRef="O_Reconcile" targetRef="O_ReconcileOK" />
    <sequenceFlow id="O_F4" name="sí" sourceRef="O_ReconcileOK" targetRef="O_GenerateReport" />
    <sequenceFlow id="O_F5" name="no" sourceRef="O_ReconcileOK" targetRef="O_CreateIncident" />
    <sequenceFlow id="O_F6" sourceRef="O_CreateIncident" targetRef="O_Review" />
    <sequenceFlow id="O_F7" sourceRef="O_Review" targetRef="O_Adjust" />
    <sequenceFlow id="O_F8" sourceRef="O_Adjust" targetRef="O_GenerateReport" />
    <sequenceFlow id="O_F9" sourceRef="O_GenerateReport" targetRef="O_End" />
  </process>
  <message id="Msg_Request" name="Solicitud interbancaria" />
  <message id="Msg_Response" name="Respuesta bancaria" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Multired_Ordered">
    <bpmndi:BPMNPlane id="BPMNPlane_Multired_Ordered" bpmnElement="Collaboration_Multired">
      <bpmndi:BPMNShape id="Participant_ATM_di" bpmnElement="Participant_ATM" isHorizontal="true">
        <dc:Bounds x="160" y="55" width="4323" height="635" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ATM_di" bpmnElement="Lane_ATM" isHorizontal="true">
